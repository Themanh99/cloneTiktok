# APP
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# DATABASE
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/tiktok_db?schema=public"

# REDIS
REDIS_URL="redis://localhost:6379"

# RABBITMQ
RABBITMQ_URL="amqp://tiktok:tiktok123@localhost:5672"
RABBITMQ_VIDEO_TRANSCODE_QUEUE="video.transcode"

# MINIO THROUGH THE EXISTING S3-COMPATIBLE STORAGE CODE
AWS_S3_BUCKET=tiktok-videos
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=tiktok
AWS_SECRET_ACCESS_KEY=tiktok123
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_PRESIGN_ENDPOINT=http://localhost:9000
AWS_S3_PUBLIC_URL=http://localhost:8080/media

# JWT
JWT_ACCESS_SECRET=change_me_to_random_string_64chars_for_local_access_token
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change_me_to_another_random_string_64chars_for_local_refresh_token
JWT_REFRESH_EXPIRATION=7d

# GOOGLE OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OPERATIONAL
VIEW_BATCH_INTERVAL_MINUTES=5
LIKE_BATCH_INTERVAL_MINUTES=5
COMMENT_RATE_LIMIT=5
COMMENT_RATE_WINDOW_SECONDS=60
